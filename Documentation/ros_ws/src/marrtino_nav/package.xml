<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>marrtino_nav</name>
  <version>0.1.0</version>
  <description>
    Nodo ROS 2 che espone lo stack di navigazione MARRtino: sottoscrive i sensori
    pubblicati dal simulatore Unity e produce i comandi di velocita'. Contiene
    solo cablaggio: la matematica sta in marrtino_core.
  </description>
  <maintainer email="halitchi.1836170@studenti.uniroma1.it">Andrei Halitchi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>marrtino_core</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
